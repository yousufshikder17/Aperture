# Authentication: development mode is rejected when NODE_ENV=production.
AUTH_MODE=development
AUTH_DEV_FREE_TOKEN=replace-with-random-free-token-at-least-32-characters
AUTH_DEV_PREMIUM_TOKEN=replace-with-random-premium-token-at-least-32-characters
AUTH_DEV_ADMIN_TOKEN=replace-with-random-admin-token-at-least-32-characters
NEXT_PUBLIC_AUTH_DEV_TOKEN=replace-with-one-of-the-development-tokens

# Production OIDC/JWT resource-server configuration:
# AUTH_MODE=oidc
# AUTH_ISSUER=https://identity.example.com/
# AUTH_AUDIENCE=https://api.example.com
# AUTH_JWKS_URL=https://identity.example.com/.well-known/jwks.json
# AUTH_ALLOWED_ALGORITHMS=RS256
# AUTH_ADMIN_SUBJECTS=verified-operator-subject

# Generic AI-provider adapters: claude | gemini | openai | ollama
FAST_PROVIDER=gemini
# QUALITY_PROVIDER=claude
# AI_PROVIDER=gemini
# DEV_PROVIDER=ollama

ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.1

# Resource classification can avoid provider calls when registry tags are present.
# COMPLEXITY_SOURCE=registry-first
MAX_RESUME_UPLOAD_BYTES=8388608

DATABASE_URL=postgresql://user:password@database.example.com/aperture?sslmode=require
DUCKDB_PATH=./analytics.duckdb
RESOURCE_REGISTRY_URL=https://raw.githubusercontent.com/yousufshikder/aperture-resources/main/registry.json

API_PORT=8787
API_BASE_URL=http://localhost:8787
NEXT_PUBLIC_API_BASE_URL=http://localhost:8787
